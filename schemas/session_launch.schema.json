{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionLaunch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "account_id",
    "slot_id",
    "lease_id",
    "session_epoch",
    "auth_mode",
    "credential_ref",
    "proxy_ref",
    "local_socks5_port",
    "adapter_port",
    "adapter_token_ref",
    "sandbox_home",
    "hwid_store_path",
    "allowed_worlds",
    "task_id",
    "config_hash",
    "telemetry_disabled"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "session_id": {"type": "string", "minLength": 4},
    "account_id": {"type": "string", "pattern": "^acc_[a-z0-9_]+$"},
    "slot_id": {"type": "integer", "minimum": 0},
    "lease_id": {"type": "string", "minLength": 4},
    "session_epoch": {"type": "integer", "minimum": 1},
    "auth_mode": {"type": "string", "enum": ["LEGACY_CREDENTIALS", "JAGEX_SESSION"]},
    "credential_ref": {"type": "string", "pattern": "^vault://[A-Za-z0-9_./-]+$"},
    "proxy_ref": {"type": "string", "pattern": "^vault://[A-Za-z0-9_./-]+$"},
    "local_socks5_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "adapter_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "adapter_token_ref": {"type": "string", "pattern": "^(vault|runtime)://[A-Za-z0-9_./-]+$"},
    "sandbox_home": {"type": "string", "minLength": 3},
    "hwid_store_path": {"type": "string", "minLength": 3},
    "allowed_worlds": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 301, "maximum": 699}
    },
    "task_id": {"type": "string", "minLength": 2},
    "config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "telemetry_disabled": {"type": "boolean", "const": true}
  }
}
