# ==============================================================================
# OSRS_ee — Local Environment Template (Copy to .env — NEVER commit .env!)
# ==============================================================================

# 1. Local Data Directory (excluded from git by .gitignore)
OSRS_EE_DATA_DIR=.osrs_ee_data

# 2. Telegram Operator Bot (Rotate old leaked tokens via @BotFather FIRST!)
TELEGRAM_BOT_TOKEN=<PUT_NEW_ROTATED_TELEGRAM_BOT_TOKEN_HERE>
TELEGRAM_CHAT_ID=<COMMA_SEPARATED_ADMIN_CHAT_IDS>
ALLOWED_CHAT_IDS=<COMMA_SEPARATED_ALLOWED_CHAT_IDS>
DEFAULT_CHANNEL_ID=<NEGATIVE_CHANNEL_OR_SUPERGROUP_ID>
TELEGRAM_TOKEN_ROTATED=false
TELEGRAM_ADMIN_USER_ID=0
TELEGRAM_ADMIN_CHAT_ID=0

# 3. Optional Proposal-Only AI Triage Gateway (chat_engen / OpenAI-compatible)
AI_ADVISORY_ENDPOINT_URL=http://127.0.0.1:8080/v1/chat/completions
AI_ADVISORY_API_KEY=<OPTIONAL_GATEWAY_BEARER_TOKEN>
AI_ADVISORY_MODEL=openai-compat-default
AI_VISION_VERIFIED=false

# 4. Live Client Runtime Paths (On your Windows or Linux host)
JAVA_BIN=java
MICROBOT_CLIENT_JAR=C:/OSRS_Runtime/microbot-runelite.jar
HWID_AGENT_JAR=
GOLDEN_CACHE_DIR=
